# --- Database ---
# Get a free Postgres instance in ~2 minutes at https://neon.tech or https://supabase.com
# Paste the connection string here. Must include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The same database over its DIRECT (non-pooled) endpoint. Prisma migrations
# take a Postgres advisory lock, which a pooler like PgBouncer cannot hold, so
# `prisma migrate` hangs until it times out without this. On Neon it is the
# same string with "-pooler" removed from the host. The app itself keeps using
# the pooled DATABASE_URL above.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# --- NextAuth ---
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Seed admin account (used only by prisma/seed.ts) ---
SEED_ADMIN_EMAIL="you@webser.io"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Admin"

# --- Stripe (wired up in Phase 3) ---
# Checkout is redirect-based, so no publishable key is needed in the browser.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Resend email (wired up in Phase 3/5) ---
RESEND_API_KEY=""
EMAIL_FROM="Webser <hello@webser.io>"



# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The hostname client domains are pointed at.
#
# Clients are shown CNAME records aiming here, and their domain is checked
# against it before their project can go Live. This must be a host you
# control that resolves to wherever client sites are served from — add one
# CNAME at your own registrar (sites -> your hosting) to make it real.
# Leave empty to switch the self-serve flow off: the portal then tells
# clients you will email them the details instead of showing records that
# point nowhere.
WEBSER_DEPLOY_HOST=sites.webser.org

# The address customers point their own domain at.
#
# Both rows they add are A records to this one address -- the root and www.
# The host routes on the Host header rather than the address, so a single
# address serves every customer and a certificate is issued per name.
#
# Set to whatever your Vercel project's Domains page shows for an A record on
# "@". Override here if they ever change it; no code change is needed.
WEBSER_APEX_IP=216.198.79.1

# Attaching client domains to the host automatically.
#
# A CNAME pointing at WEBSER_DEPLOY_HOST is only half of what makes a custom
# domain work: Vercel routes on the Host header and only answers for domains
# attached to the project. Until a domain is attached, the TLS handshake fails
# and the visitor gets a browser security warning rather than the site.
#
# With these set, saving a domain attaches it to the project, starts
# certificate issuance, fetches the exact records Vercel wants, and surfaces
# any ownership challenge (a TXT record) the client has to add. Verifying then
# re-checks that challenge and Vercel's own view of the DNS.
#
# Without them, every client domain has to be added under
# Project -> Settings -> Domains in Vercel by hand, or it will not serve at all.
#
# Domain limits: Hobby 50, Pro unlimited.
#
# VERCEL_TOKEN: create at https://vercel.com/account/tokens (scope it to the
# team that owns this project).
VERCEL_TOKEN=
# These two are identifiers rather than secrets; they are in .vercel/repo.json.
VERCEL_PROJECT_ID=prj_5osvbwK6eAIeTqhCEV2II1cTphKz
VERCEL_TEAM_ID=team_OJvDQYkkCpcSgFbZrfTGKnHw

# Shown on the public landing page as the way to reach you.
# Defaults to (913) 300-0258 if unset.
NEXT_PUBLIC_CONTACT_PHONE=

# --- AI editing (optional) ---
# Powers "Edit with AI" on a preview and "Apply with AI" on a change request.
# Both features explain themselves as unavailable when this is unset, so the
# app works fine without it.
ANTHROPIC_API_KEY=
# Only needed if your key belongs to more than one workspace.
ANTHROPIC_WORKSPACE_ID=

# --- Developer payment shortcuts ---
# Lets the client portal settle a payment without Stripe, for walking through
# the post-payment flow. On by default outside production; setting it to "true"
# turns it on IN production, where anyone holding a portal link could then mark
# their own project paid. Leave this unset when you deploy. The Settings page
# shows a red banner if it is ever on in production.
ENABLE_DEV_PAYMENTS=

# Vercel Blob — where client logos and photos are stored.
# Injected automatically on Vercel once a Blob store is connected to the
# project. Locally, leave it empty: uploads fall back to public/uploads/.
BLOB_READ_WRITE_TOKEN=
